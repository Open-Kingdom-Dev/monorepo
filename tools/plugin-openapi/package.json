{
  "name": "@open-kingdom/plugin-openapi",
  "version": "0.0.2-21",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@open-kingdom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "tools/plugin-openapi/dist",
          "main": "tools/plugin-openapi/src/index.ts",
          "tsConfig": "tools/plugin-openapi/tsconfig.lib.json",
          "rootDir": "tools/plugin-openapi/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./tools/plugin-openapi/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./tools/plugin-openapi/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "generate-openapi-all": {
        "executor": "@open-kingdom/plugin-openapi:swagger-generate-all"
      },
      "generate-client-all": {
        "executor": "@open-kingdom/plugin-openapi:generate-all-client",
        "dependsOn": [
          "generate-openapi-all"
        ]
      },
      "smoke-test": {
        "executor": "nx:run-commands",
        "dependsOn": [
          "build"
        ],
        "cache": false,
        "options": {
          "command": "node tools/plugin-openapi/scripts/smoke-test.mjs"
        }
      }
    }
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@nx/devkit": "24.0.3",
    "@rtk-query/codegen-openapi": "^2.2.0",
    "jiti": "2.4.2",
    "reflect-metadata": "^0.1.13",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  },
  "executors": "./executors.json",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "executors.json"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "type": "commonjs"
}
