{
  "name": "@open-kingdom/plugin-openapi",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@open-kingdom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "nx": {
    "targets": {
      "build": {
        "executor": "@nx/js:tsc",
        "outputs": [
          "{options.outputPath}"
        ],
        "options": {
          "outputPath": "tools/plugin-openapi/dist",
          "main": "tools/plugin-openapi/src/index.ts",
          "tsConfig": "tools/plugin-openapi/tsconfig.lib.json",
          "rootDir": "tools/plugin-openapi/src",
          "generatePackageJson": false,
          "assets": [
            {
              "input": "./tools/plugin-openapi/src",
              "glob": "**/!(*.ts)",
              "output": "."
            },
            {
              "input": "./tools/plugin-openapi/src",
              "glob": "**/*.d.ts",
              "output": "."
            }
          ]
        }
      },
      "generate-openapi-all": {
        "executor": "@open-kingdom/plugin-openapi:swagger-generate-all"
      },
      "generate-client-all": {
        "executor": "@open-kingdom/plugin-openapi:generate-all-client",
        "dependsOn": [
          "generate-openapi-all"
        ]
      }
    }
  },
  "dependencies": {
    "@nx/devkit": "22.0.3",
    "@nestjs/swagger": "^11.0.0",
    "@nx/devkit": "22.0.3",
    "openapi-typescript": "^7.5.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "ts-node": "^10.9.2",
    "typescript": "^5.6.0"
  },
  "executors": "./executors.json",
  "files": [
    "dist",
    "!**/*.tsbuildinfo",
    "executors.json"
  ]
}
