{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./out-tsc/jest",
    "jsx": "react-jsx",
    "types": [
      "jest",
      "node",
      "@nx/react/typings/cssmodule.d.ts",
      "@nx/react/typings/image.d.ts"
    ]
  },
  "files": [
    "app/test-setup.ts"
  ],
  "include": [
    "jest.config.ts",
    "app/**/*.test.ts",
    "app/**/*.spec.ts",
    "app/**/*.test.tsx",
    "app/**/*.spec.tsx",
    "app/**/*.test.js",
    "app/**/*.spec.js",
    "app/**/*.test.jsx",
    "app/**/*.spec.jsx",
    "app/**/*.d.ts",
    "test/**/*.spec.tsx",
    "test/**/*.spec.ts",
    "test/**/*.test.tsx",
    "test/**/*.test.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.app.json"
    }
  ]
}
