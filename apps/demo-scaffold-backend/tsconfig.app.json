{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "module": "nodenext",
    "types": ["node"],
    "rootDir": "src",
    "moduleResolution": "nodenext",
    "tsBuildInfoFile": "dist/tsconfig.app.tsbuildinfo",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "target": "es2021"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "out-tsc",
    "dist",
    "jest.config.ts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "eslint.config.js",
    "eslint.config.cjs",
    "eslint.config.mjs"
  ],
  "references": [
    {
      "path": "../../libs/shared/backend/data-access-users/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/backend/util-rbac/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/backend/feature-gcp-resources/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/backend/feature-user-management/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/backend/feature-email/tsconfig.lib.json"
    },
    {
      "path": "../../libs/demo-scaffold/backend/feature-root-schema/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/backend/feature-authentication/tsconfig.lib.json"
    },
    {
      "path": "../../libs/shared/poly/util-env-config/tsconfig.lib.json"
    }
  ]
}
