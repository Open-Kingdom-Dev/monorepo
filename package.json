    "lint:fix": "nx run-many --target=lint --all --fix",
    "format:fix": "nx format --all",
    "format:check": "nx format:check --all",
    "check-all": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run e2e",
    "swagger:generate-all": "nx run @open-kingdom/plugin-openapi:generate-openapi-all",
