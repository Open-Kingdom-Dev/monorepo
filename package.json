{
  "name": "@open-kingdom/source",
  "version": "0.0.2-6",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "nx run @open-kingdom/demo-scaffold:dev",
    "dev:backend": "nx run @open-kingdom/demo-scaffold-backend:serve",
    "test": "nx run-many --target=test --all --coverage",
    "test:affected": "nx affected --target=test --coverage",
    "typecheck": "nx run-many --target=typecheck --all",
    "typecheck:affected": "nx affected --target=typecheck",
    "e2e": "nx run demo-scaffold-e2e:e2e",
    "e2e:open": "nx run demo-scaffold-e2e:e2e --ui",
    "lint": "nx run-many --target=lint --all",
    "lint:fix": "nx run-many --target=lint --all --fix",
    "format:fix": "nx format --all",
    "format:check": "nx format:check --all",
    "check-all": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run e2e",
    "swagger:generate-all": "nx run @open-kingdom/plugin-openapi:generate-openapi-all",
    "client:generate-all": "nx run @open-kingdom/plugin-openapi:generate-client-all"
  },
  "devDependencies": {
