{
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/tsconfig.lib.tsbuildinfo",
    "emitDeclarationOnly": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2021",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/*.spec.ts", "src/**/*.test.ts"],
  "references": [
    {
      "path": "../../../shared/backend/data-access-opportunities/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/backend/data-access-contacts/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/backend/data-access-activity-log/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/backend/data-access-configurable-lookups/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/backend/feature-user-management/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/backend/data-access-users/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/backend/data-access-database-setup/tsconfig.lib.json"
    },
    {
      "path": "../../../shared/poly/util-constants/tsconfig.lib.json"
    }
  ]
}
