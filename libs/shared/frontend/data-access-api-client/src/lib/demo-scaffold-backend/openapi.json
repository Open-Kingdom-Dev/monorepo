{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Authenticate user with email and password credentials",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "User login credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "examples": {
                "admin": {
                  "summary": "Admin login",
                  "value": {
                    "email": "admin@admin.com",
                    "password": "admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials - email or password is incorrect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid credentials"
                    },
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "User login",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/profile": {
      "get": {
        "description": "Returns the authenticated user profile. Requires a valid JWT token in the Authorization header.",
        "operationId": "AuthController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get user profile",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/users": {
      "get": {
        "description": "Get a list of all registered users. Requires authentication.",
        "operationId": "UsersController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of users",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/UserDto"
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "List all users",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/users/{id}": {
      "get": {
        "description": "Get a single user by their ID. Requires authentication.",
        "operationId": "UsersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "User ID",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get user by ID",
        "tags": [
          "Users"
        ]
      },
      "delete": {
        "description": "Delete a user by their ID. Users cannot delete themselves.",
        "operationId": "UsersController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "User ID to delete",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Cannot delete own account"
          },
          "401": {
            "description": "Unauthorized"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Delete user",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/invitations/invite": {
      "post": {
        "description": "Send an invitation email to a new user. Requires authentication.",
        "operationId": "InvitationsController_invite",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InviteUserResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "User already exists or invitation already sent"
          },
          "401": {
            "description": "Unauthorized"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Send invitation",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/invitations/validate/{token}": {
      "get": {
        "description": "Check if an invitation token is valid and not expired.",
        "operationId": "InvitationsController_validate",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "description": "The invitation token to validate",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Token validation result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidateInvitationResponseDto"
                }
              }
            }
          }
        },
        "summary": "Validate invitation token",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/invitations/accept": {
      "post": {
        "description": "Accept an invitation and create a new user account.",
        "operationId": "InvitationsController_accept",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Account created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptInvitationResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid or expired invitation"
          }
        },
        "summary": "Accept invitation",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/email/send": {
      "post": {
        "description": "Send a test email via Gmail API",
        "operationId": "EmailController_sendEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Email details",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailDto"
              },
              "examples": {
                "test": {
                  "summary": "Test email",
                  "value": {
                    "to": "test@example.com",
                    "subject": "Test Subject",
                    "body": "Hello, this is a test email."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Email sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailResponseDto"
                }
              }
            }
          }
        },
        "summary": "Send test email",
        "tags": [
          "Email"
        ]
      }
    }
  },
  "info": {
    "title": "Demo scaffold API",
    "description": "API support for the demo scaffold application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "demo-scaffold",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "admin@admin.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "admin",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "User ID",
            "example": 1
          },
          "firstName": {
            "type": "string",
            "description": "User first name",
            "example": "John",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "description": "User last name",
            "example": "Doe",
            "nullable": true
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "john@example.com"
          },
          "invitee": {
            "type": "number",
            "description": "ID of user who invited this user",
            "example": null,
            "nullable": true
          },
          "role": {
            "type": "string",
            "description": "User role",
            "example": "user",
            "enum": [
              "guest",
              "user",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "invitee",
          "role"
        ]
      },
      "UserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "User ID",
            "example": 1
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "user@example.com"
          },
          "firstName": {
            "type": "object",
            "description": "User first name",
            "example": "John"
          },
          "lastName": {
            "type": "object",
            "description": "User last name",
            "example": "Doe"
          },
          "role": {
            "type": "string",
            "description": "User role",
            "enum": [
              "guest",
              "user",
              "admin"
            ],
            "example": "user"
          }
        },
        "required": [
          "id",
          "email",
          "role"
        ]
      },
      "DeleteUserResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the user was deleted successfully",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Message describing the result",
            "example": "User deleted successfully"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "InviteUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address to send invitation to",
            "example": "user@example.com",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "Role to assign to the invited user",
            "enum": [
              "guest",
              "user",
              "admin"
            ],
            "default": "user"
          }
        },
        "required": [
          "email"
        ]
      },
      "InviteUserResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the invitation was sent successfully",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Message describing the result",
            "example": "Invitation sent successfully"
          },
          "token": {
            "type": "string",
            "description": "The generated invitation token (for testing purposes)",
            "example": "eyJlbWFpbCI6InVzZXJAZXhhbXBsZS5jb20iLCJleHBpcmVzQXQiOjE3MDk4MjQwMDB9"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "ValidateInvitationResponseDto": {
        "type": "object",
        "properties": {
          "valid": {
            "type": "boolean",
            "description": "Whether the invitation token is valid",
            "example": true
          },
          "email": {
            "type": "string",
            "description": "Email address associated with the invitation",
            "example": "user@example.com"
          },
          "role": {
            "type": "string",
            "description": "Role assigned to the invitation",
            "enum": [
              "guest",
              "user",
              "admin"
            ]
          },
          "error": {
            "type": "string",
            "description": "Error message if validation failed",
            "example": "Invitation has expired"
          }
        },
        "required": [
          "valid"
        ]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "The invitation token received via email",
            "example": "eyJlbWFpbCI6InVzZXJAZXhhbXBsZS5jb20iLCJleHBpcmVzQXQiOjE3MDk4MjQwMDB9"
          },
          "password": {
            "type": "string",
            "description": "Password for the new account",
            "example": "securePassword123",
            "minLength": 8
          },
          "firstName": {
            "type": "string",
            "description": "First name of the user",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the user",
            "example": "Doe"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "AcceptInvitationResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the account was created successfully",
            "example": true
          },
          "message": {
            "type": "string",
            "description": "Message describing the result",
            "example": "Account created successfully"
          },
          "email": {
            "type": "string",
            "description": "Email of the created user",
            "example": "user@example.com"
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "SendEmailDto": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address",
            "example": "recipient@example.com",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line",
            "example": "Test Email Subject"
          },
          "body": {
            "type": "string",
            "description": "Email body content",
            "example": "Hello, this is a test email."
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ]
      },
      "SendEmailResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the email was sent successfully",
            "example": true
          },
          "messageId": {
            "type": "string",
            "description": "Gmail message ID if successful",
            "example": "18c1234567890abc"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed",
            "example": "Invalid recipient address"
          }
        },
        "required": [
          "success"
        ]
      }
    }
  }
}