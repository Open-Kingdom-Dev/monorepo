    "/api/gcp/projects": {
      "get": {
        "description": "List all projects under a GCP organization or folder. Parent must be `folders/{folder_id}` or `organizations/{org_id}`.",
        "operationId": "GcpProjectsController_listProjects",
        "parameters": [
          {
            "name": "parent",
            "required": true,
            "in": "query",
            "description": "Parent resource: folders/{folder_id} or organizations/{org_id}",
            "schema": {
              "example": "folders/123456789",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of projects",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/GcpProjectSummaryDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid parent parameter"
          }
        },
        "summary": "List GCP projects in org or folder",
        "tags": [
          "GCP Resources"
        ]
      },
      "post": {
        "description": "Create a new project in GCP. The project will be created under the specified parent (folder or organization).",
        "operationId": "GcpProjectsController_createProject",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Project creation details",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateProjectDto"
              },
              "examples": {
                "example": {
                  "summary": "Create a new project",
                  "value": {
                    "projectId": "my-new-project",
                    "displayName": "My New Project",
                    "parent": "folders/123456789"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Project created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateProjectResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request - missing required fields or invalid project ID"
          }
        },
        "summary": "Create a new GCP project",
        "tags": [
          "GCP Resources"
        ]
      }
    }
  },
  "info": {
    "title": "Demo scaffold API",
    "description": "API support for the demo scaffold application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "demo-scaffold",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "admin@admin.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "admin",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "User ID",
            "example": 1
          },
          "firstName": {
            "type": "string",
            "description": "User first name",
            "example": "John",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "description": "User last name",
            "example": "Doe",
            "nullable": true
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "john@example.com"
          },
          "role": {
            "type": "string",
            "description": "Primary role name",
            "example": "admin",
            "nullable": true
          },
          "permissions": {
            "description": "Granted permissions",
            "example": [
              "users:read",
              "users:write"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "role",
          "permissions"
        ]
      },
      "SendEmailDto": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address",
            "example": "recipient@example.com",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line",
            "example": "Test Email Subject"
          },
          "body": {
            "type": "string",
            "description": "Email body content",
            "example": "Hello, this is a test email."
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ]
      },
      "SendEmailResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the email was sent successfully",
            "example": true
          },
          "messageId": {
            "type": "string",
            "description": "Gmail message ID if successful",
            "example": "18c1234567890abc"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed",
            "example": "Invalid recipient address"
          }
        },
        "required": [
          "success"
        ]
      },
      "InviteUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address of the user to invite",
            "example": "newuser@example.com",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "Role name to assign to the invited user",
            "example": "guest",
            "default": "guest"
          }
        },
        "required": [
          "email"
        ]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Invitation token from the invite link",
            "example": "abc123def456"
          },
          "password": {
            "type": "string",
            "description": "Password for the new account",
            "example": "securePassword123",
            "minLength": 8
          },
          "firstName": {
            "type": "string",
            "description": "First name of the user",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the user",
            "example": "Doe"
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "CreateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Unique role name",
            "example": "editor"
          },
          "description": {
            "type": "string",
            "description": "Role description",
            "example": "Content editor with publishing rights"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateRoleDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "New role name"
          },
          "description": {
            "type": "string",
            "description": "New description"
          }
        }
      },
      "SetRolePermissionsDto": {
        "type": "object",
        "properties": {
          "permissionIds": {
            "description": "Array of permission IDs to assign",
            "example": [
              1,
              2,
              3
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "permissionIds"
        ]
      },
      "CreatePermissionDto": {
        "type": "object",
        "properties": {
          "resource": {
            "type": "string",
            "description": "Resource name",
            "example": "articles"
          },
          "action": {
            "type": "string",
            "description": "Action name",
            "example": "publish"
          },
          "description": {
            "type": "string",
            "description": "Permission description"
          }
        },
        "required": [
          "resource",
          "action"
        ]
      },
      "UpdateUserRolesDto": {
        "type": "object",
        "properties": {
          "roleIds": {
            "description": "Array of role IDs to assign (replaces all existing roles)",
            "example": [
              1,
              2
            ],
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "roleIds"
        ]
      },
      "AssignUserRoleDto": {
        "type": "object",
        "properties": {
          "roleId": {
            "type": "number",
            "description": "Role ID to assign",
            "example": 2
          }
        },
        "required": [
          "roleId"
        ]
      },
      "GcpProjectSummaryDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full resource name (e.g. projects/123)",
            "example": "projects/my-project-id"
          },
          "projectId": {
            "type": "string",
            "description": "Project ID",
            "example": "my-project-id"
          },
          "displayName": {
            "type": "string",
            "description": "Display name",
            "example": "My Project"
          },
          "state": {
            "type": "object",
            "description": "Project lifecycle state (e.g. ACTIVE, DELETE_REQUESTED)",
            "example": "ACTIVE"
          }
        },
        "required": [
          "name",
          "projectId"
        ]
      },
      "CreateProjectDto": {
        "type": "object",
        "properties": {
          "projectId": {
            "type": "string",
            "description": "Project ID (must be unique, lowercase letters, numbers, and hyphens)",
            "example": "my-new-project"
          },
          "displayName": {
            "type": "string",
            "description": "Display name for the project",
            "example": "My New Project"
          },
          "parent": {
            "type": "string",
            "description": "Parent resource: folders/{folder_id} or organizations/{org_id}",
            "example": "folders/123456789"
          }
        },
        "required": [
          "projectId",
          "parent"
        ]
      },
      "CreateProjectResponseDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "Full resource name (e.g. projects/123)",
            "example": "projects/my-new-project"
          },
          "projectId": {
            "type": "string",
            "description": "Project ID",
            "example": "my-new-project"
          },
          "displayName": {
            "type": "string",
            "description": "Display name",
            "example": "My New Project"
          },
          "state": {
            "type": "object",
            "description": "Project lifecycle state",
            "example": "ACTIVE"
          }
        },
        "required": [
          "name",
          "projectId"
        ]
      }
    }
  }
}