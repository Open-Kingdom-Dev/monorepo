{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Authenticate user with email and password credentials",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "User login credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "examples": {
                "admin": {
                  "summary": "Admin login",
                  "value": {
                    "email": "admin@admin.com",
                    "password": "admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials - email or password is incorrect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid credentials"
                    },
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "User login",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/profile": {
      "get": {
        "description": "Returns the authenticated user profile. Requires a valid JWT token in the Authorization header.",
        "operationId": "AuthController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get user profile",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/email/send": {
      "post": {
        "description": "Send a test email via Gmail API",
        "operationId": "EmailController_sendEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Email details",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailDto"
              },
              "examples": {
                "test": {
                  "summary": "Test email",
                  "value": {
                    "to": "test@example.com",
                    "subject": "Test Subject",
                    "body": "Hello, this is a test email."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Email sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailResponseDto"
                }
              }
            }
          }
        },
        "summary": "Send test email",
        "tags": [
          "Email"
        ]
      }
    }
  },
  "info": {
    "title": "Demo scaffold API",
    "description": "API support for the demo scaffold application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "demo-scaffold",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "admin@admin.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "admin",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "User ID",
            "example": 1
          },
          "firstName": {
            "type": "string",
            "description": "User first name",
            "example": "John",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "description": "User last name",
            "example": "Doe",
            "nullable": true
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "john@example.com"
          },
          "invitee": {
            "type": "number",
            "description": "ID of user who invited this user",
            "example": null,
            "nullable": true
          },
          "role": {
            "type": "string",
            "description": "User role",
            "example": "user",
            "enum": [
              "guest",
              "user",
              "admin"
            ]
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email",
          "invitee",
          "role"
        ]
      },
      "SendEmailDto": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address",
            "example": "recipient@example.com",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line",
            "example": "Test Email Subject"
          },
          "body": {
            "type": "string",
            "description": "Email body content",
            "example": "Hello, this is a test email."
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ]
      },
      "SendEmailResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the email was sent successfully",
            "example": true
          },
          "messageId": {
            "type": "string",
            "description": "Gmail message ID if successful",
            "example": "18c1234567890abc"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed",
            "example": "Invalid recipient address"
          }
        },
        "required": [
          "success"
        ]
      }
    }
  }
}