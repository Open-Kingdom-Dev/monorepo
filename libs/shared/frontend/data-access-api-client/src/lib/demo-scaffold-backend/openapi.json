{
  "openapi": "3.0.0",
  "paths": {
    "/api/auth/login": {
      "post": {
        "description": "Authenticate user with email and password credentials",
        "operationId": "AuthController_login",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "User login credentials",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginDto"
              },
              "examples": {
                "admin": {
                  "summary": "Admin login",
                  "value": {
                    "email": "admin@admin.com",
                    "password": "admin"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LoginResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials - email or password is incorrect",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Invalid credentials"
                    },
                    "error": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "User login",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/profile": {
      "get": {
        "description": "Returns the authenticated user profile. Requires a valid JWT token in the Authorization header.",
        "operationId": "AuthController_getProfile",
        "parameters": [],
        "responses": {
          "200": {
            "description": "User profile retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProfileResponseDto"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "statusCode": {
                      "type": "number",
                      "example": 401
                    },
                    "message": {
                      "type": "string",
                      "example": "Unauthorized"
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get user profile",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/email/send": {
      "post": {
        "description": "Send a test email via Gmail API",
        "operationId": "EmailController_sendEmail",
        "parameters": [],
        "requestBody": {
          "required": true,
          "description": "Email details",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendEmailDto"
              },
              "examples": {
                "test": {
                  "summary": "Test email",
                  "value": {
                    "to": "test@example.com",
                    "subject": "Test Subject",
                    "body": "Hello, this is a test email."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Email sent successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SendEmailResponseDto"
                }
              }
            }
          }
        },
        "summary": "Send test email",
        "tags": [
          "Email"
        ]
      }
    },
    "/api/invitations/invite": {
      "post": {
        "description": "Send an invitation to a new user. Requires authentication.",
        "operationId": "InvitationsController_invite",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/InviteUserDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Invitation created successfully"
          },
          "400": {
            "description": "User already exists or pending invitation exists"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Invite a new user",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/invitations/validate/{token}": {
      "get": {
        "description": "Check if an invitation token is valid and not expired",
        "operationId": "InvitationsController_validate",
        "parameters": [
          {
            "name": "token",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Validation result",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "valid": {
                      "type": "boolean"
                    },
                    "email": {
                      "type": "string",
                      "nullable": true
                    },
                    "role": {
                      "type": "string",
                      "enum": [
                        "guest",
                        "user",
                        "admin"
                      ],
                      "nullable": true
                    }
                  }
                }
              }
            }
          }
        },
        "summary": "Validate an invitation token",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/invitations/accept": {
      "post": {
        "description": "Accept an invitation and create a new user account",
        "operationId": "InvitationsController_accept",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AcceptInvitationDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully"
          },
          "400": {
            "description": "Invalid or expired invitation token"
          }
        },
        "summary": "Accept an invitation",
        "tags": [
          "Invitations"
        ]
      }
    },
    "/api/users": {
      "get": {
        "description": "Returns a list of all users without passwords",
        "operationId": "UsersController_findAll",
        "parameters": [],
        "responses": {
          "200": {
            "description": "List of users"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "List all users",
        "tags": [
          "Users"
        ]
      }
    },
    "/api/users/{id}": {
      "get": {
        "description": "Returns a single user by their ID",
        "operationId": "UsersController_findOne",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User found"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Get a user by ID",
        "tags": [
          "Users"
        ]
      },
      "delete": {
        "description": "Delete a user by their ID. Cannot delete your own account.",
        "operationId": "UsersController_delete",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User deleted successfully"
          },
          "401": {
            "description": "Unauthorized - Invalid or missing JWT token"
          },
          "403": {
            "description": "Cannot delete your own account"
          },
          "404": {
            "description": "User not found"
          }
        },
        "security": [
          {
            "JWT-auth": []
          }
        ],
        "summary": "Delete a user",
        "tags": [
          "Users"
        ]
      }
    }
  },
  "info": {
    "title": "Demo scaffold API",
    "description": "API support for the demo scaffold application",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "demo-scaffold",
      "description": ""
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "JWT-auth": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "name": "JWT",
        "description": "Enter JWT token",
        "in": "header"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "admin@admin.com",
            "format": "email"
          },
          "password": {
            "type": "string",
            "description": "User password",
            "example": "admin",
            "minLength": 1
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "access_token": {
            "type": "string",
            "description": "JWT access token",
            "example": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
          }
        },
        "required": [
          "access_token"
        ]
      },
      "ProfileResponseDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "number",
            "description": "User ID",
            "example": 1
          },
          "firstName": {
            "type": "string",
            "description": "User first name",
            "example": "John",
            "nullable": true
          },
          "lastName": {
            "type": "string",
            "description": "User last name",
            "example": "Doe",
            "nullable": true
          },
          "email": {
            "type": "string",
            "description": "User email address",
            "example": "john@example.com"
          }
        },
        "required": [
          "id",
          "firstName",
          "lastName",
          "email"
        ]
      },
      "SendEmailDto": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "Recipient email address",
            "example": "recipient@example.com",
            "format": "email"
          },
          "subject": {
            "type": "string",
            "description": "Email subject line",
            "example": "Test Email Subject"
          },
          "body": {
            "type": "string",
            "description": "Email body content",
            "example": "Hello, this is a test email."
          }
        },
        "required": [
          "to",
          "subject",
          "body"
        ]
      },
      "SendEmailResponseDto": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "description": "Whether the email was sent successfully",
            "example": true
          },
          "messageId": {
            "type": "string",
            "description": "Gmail message ID if successful",
            "example": "18c1234567890abc"
          },
          "error": {
            "type": "string",
            "description": "Error message if failed",
            "example": "Invalid recipient address"
          }
        },
        "required": [
          "success"
        ]
      },
      "InviteUserDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "description": "Email address of the user to invite",
            "example": "newuser@example.com",
            "format": "email"
          },
          "role": {
            "type": "string",
            "description": "Role to assign to the invited user",
            "example": "user",
            "enum": [
              "guest",
              "user",
              "admin"
            ],
            "default": "guest"
          }
        },
        "required": [
          "email"
        ]
      },
      "AcceptInvitationDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "description": "Invitation token from the invite link",
            "example": "abc123def456"
          },
          "password": {
            "type": "string",
            "description": "Password for the new account",
            "example": "securePassword123",
            "minLength": 8
          },
          "firstName": {
            "type": "string",
            "description": "First name of the user",
            "example": "John"
          },
          "lastName": {
            "type": "string",
            "description": "Last name of the user",
            "example": "Doe"
          }
        },
        "required": [
          "token",
          "password"
        ]
      }
    }
  }
}