{
  "name": "@open-kingdom/shared-frontend-ui-theme",
  "version": "0.0.2-16",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    "./tailwind.config.js": "./dist/tailwind.config.js",
    "./styles/tokens.css": "./src/styles/tokens.css",
    ".": {
      "@open-kingdom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "README.md",
    "dist",
    "src/styles",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "scope:shared",
      "type:ui",
      "environment:frontend"
    ]
  },
  "peerDependencies": {
    "clsx": "^2.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^3.4.0",
    "tailwindcss-animate": "^1.0.0",
    "react": "^19.0.0"
  }
}
