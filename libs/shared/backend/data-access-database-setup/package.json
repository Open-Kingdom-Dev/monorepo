{
  "name": "@open-kingdom/shared-backend-data-access-database-setup",
  "version": "0.0.2-14",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "db:generate": "drizzle-kit generate --config=../../../../apps/demo-scaffold-backend/drizzle.config.ts",
    "db:migrate": "drizzle-kit migrate --config=../../../../apps/demo-scaffold-backend/drizzle.config.ts",
    "db:push": "drizzle-kit push --config=../../../../apps/demo-scaffold-backend/drizzle.config.ts",
    "db:studio": "drizzle-kit studio --config=../../../../apps/demo-scaffold-backend/drizzle.config.ts"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@open-kingdom/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "nx": {
    "tags": [
      "scope:shared",
      "type:data-access",
      "environment:backend"
    ]
  },
  "dependencies": {
    "tslib": "^2.3.0",
    "@knaadh/nestjs-drizzle-better-sqlite3": "^1.2.0",
    "@nestjs/common": "^11.0.0",
    "@open-kingdom/shared-poly-util-constants": "0.0.2-14"
  }
}
